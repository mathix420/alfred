{
  "name": "alfred",
  "private": true,
  "workspaces": [
    "apps/pocket"
  ],
  "type": "module",
  "scripts": {
    "dev": "bun run --filter @alfred/pocket dev",
    "build": "bun run --filter @alfred/pocket build",
    "test": "bun test",
    "typecheck": "bun run --filter '*' typecheck",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "firmware:build": "pio run -d apps/pocket/firmware -e companion_v1",
    "firmware:flash": "pio run -d apps/pocket/firmware -e companion_v1 -t upload"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "oxfmt": "latest",
    "oxlint": "latest",
    "typescript": "latest"
  }
}
