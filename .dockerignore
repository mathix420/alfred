# Only application sources and browser assets belong in the build context.
**
!Dockerfile
!.dockerignore
!apps/
!apps/pocket/
!apps/pocket/src/
!apps/pocket/src/**
!apps/pocket/web/
!apps/pocket/web/**
!apps/pocket/matrix/
!apps/pocket/matrix/**
# Never include local credentials, Matrix identity, audio, or generated files.
**/.env
**/.env.*
**/.data
**/node_modules
**/__pycache__
**/*.py[cod]
**/*.db
**/*.db-*
**/*.pickle
**/*.pem
**/*.key
**/*.wav
**/*.ogg
**/*.mp3
