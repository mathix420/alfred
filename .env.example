# --- LLM provider credentials ---
# Anthropic (models addressed as "anthropic/<model>")
ANTHROPIC_API_KEY=

# Mistral (models addressed as "mistral/<model>")
MISTRAL_API_KEY=

# --- Local LLMs ("local/<model>") ---
# Any OpenAI-compatible server: Ollama, LM Studio, llama.cpp, vLLM, ...
ALFRED_LOCAL_BASE_URL=http://localhost:11434/v1

# --- Neo4j ("second brain" graph + vector store) ---
# Docker seeds the DB from NEO4J_AUTH=<user>/<password> on FIRST boot only.
# Keep all of these in sync. Password >= 8 chars; quote if it has symbols.
# IMPORTANT: connect with bolt:// (NOT neo4j://) — the routing scheme hangs under Bun.
NEO4J_AUTH=neo4j/change-me-to-a-long-random-password
ALFRED_NEO4J_URI=bolt://localhost:7687
ALFRED_NEO4J_USER=neo4j
ALFRED_NEO4J_PASSWORD=change-me-to-a-long-random-password
ALFRED_NEO4J_DATABASE=neo4j

# --- Embeddings for the Neo4j vector index ("<provider>/<model>") ---
# DIMENSIONS must EXACTLY match the model's output width or recall breaks.
#   local/nomic-embed-text        -> 768
#   local/mxbai-embed-large       -> 1024
#   mistral/mistral-embed         -> 1024
#   openai/text-embedding-3-small -> 1536
ALFRED_EMBEDDING_MODEL=local/nomic-embed-text
ALFRED_EMBEDDING_DIMENSIONS=768
ALFRED_EMBEDDING_SIMILARITY=cosine

# --- companion (apps/companion) — the ESP32-S3 pocket-device bridge ---
# The WebSocket bridge the device connects to over WiFi/LAN.
ALFRED_COMPANION_HOST=0.0.0.0
ALFRED_COMPANION_PORT=9191
ALFRED_COMPANION_MODEL=anthropic/claude-opus-4-8
# Local speech-to-text (whisper.cpp). Point BINARY/MODEL at your build + ggml model.
ALFRED_STT_ENGINE=whisper-cpp
ALFRED_STT_BINARY=whisper-cli
ALFRED_STT_MODEL=models/ggml-base.en.bin
# ALFRED_STT_LANGUAGE=en                 # omit to auto-detect
# Local text-to-speech (Piper). MODEL is the voice .onnx; a British voice suits Alfred.
ALFRED_TTS_ENGINE=piper
ALFRED_TTS_BINARY=piper
ALFRED_TTS_MODEL=voices/en_GB-alan-medium.onnx
ALFRED_TTS_SAMPLE_RATE=22050

# Pocket app — direct TodoMate REST API, Matrix voice (no Hermes API key needed).
# Leave TodoMate URL/token blank to use demo tasks.
ALFRED_TODOMATE_API_URL=
TODOMATE_MCP_ACCESS_TOKEN=
ALFRED_POCKET_HOST=127.0.0.1
ALFRED_POCKET_PORT=9191
ALFRED_POCKET_POLL_MS=60000
# When served behind a reverse proxy, set the exact browser origin, e.g. https://alfred.example.org
ALFRED_POCKET_PUBLIC_ORIGIN=
# Native device uses wss://<backend-host>/ws and its own device token.

# Shared only with your own device/browser. Required for remote access and Matrix.
ALFRED_DEVICE_TOKEN=

# Optional: send voice into your existing encrypted Matrix/Beeper conversation.
# Use a NEW dedicated Matrix device/session on YOUR account, not Hermes's account.
ALFRED_MATRIX_ENABLED=false
ALFRED_MATRIX_HOMESERVER=
ALFRED_MATRIX_USER_ID=
ALFRED_MATRIX_ACCESS_TOKEN=
ALFRED_MATRIX_DEVICE_ID=
ALFRED_MATRIX_HERMES_USER_ID=
ALFRED_MATRIX_ROOM_ID=
# Stable secret protecting the persistent crypto store; retain with your backup.
ALFRED_MATRIX_PICKLE_KEY=
# JSON array: [{"userId":"@hermes:example.org","deviceId":"DEVICE","ed25519":"verified-unpadded-base64-key"}]
ALFRED_MATRIX_TRUSTED_DEVICES=
ALFRED_MATRIX_REPLY_TIMEOUT_MS=180000
# Docker configures these automatically under /data; local defaults use .data.
# ALFRED_MATRIX_STORE_DIR=/data/matrix
# ALFRED_POCKET_VOICE_DIR=/data/voice
# ALFRED_MATRIX_PYTHON=/opt/venv/bin/python
